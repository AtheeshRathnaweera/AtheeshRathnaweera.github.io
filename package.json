{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.6",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "node scripts/check-vulnerabilities.mjs --postinstall",
    "check-vulnerabilities": "node scripts/check-vulnerabilities.mjs",
    "check-vulnerabilities:ci": "node scripts/check-vulnerabilities.mjs --level=high --prod-only --strict"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "flowbite-react": "^0.12.17",
    "framer-motion": "^12.23.26",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "flowbite-typography": "^1.0.5",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.9",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
